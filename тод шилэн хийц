<!DOCTYPE html>
<html lang="mn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Тод Шилэн Хийц — Шилэн Бүтээгдэхүүн</title>
  <meta name="description" content="Тод Шилэн Хийц — Монголын чанарын шилэн бүтээгдэхүүн. Толь, шилэн хийц, декоратив шил." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- Loader -->
  <div class="loader" id="loader">
    <div class="loader-logo">
      <img src="images/logo.svg" alt="Тод Шилэн Хийц" />
    </div>
    <div class="loader-bar"><div class="loader-progress"></div></div>
  </div>

  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="#home" class="nav-logo">
        <img src="images/logo.svg" alt="Тод Шилэн Хийц лого" class="logo-img" />
        <div class="logo-text-wrap">
          <span class="logo-mn">ТОД ШИЛЭН ХИЙЦ</span>
          <span class="logo-sub">Шилэн Бүтээгдэхүүн</span>
        </div>
      </a>
      <ul class="nav-links" id="navLinks">
        <li><a href="#home">Нүүр</a></li>
        <li><a href="#products">Бүтээгдэхүүн</a></li>
        <li><a href="#about">Танилцуулга</a></li>
        <li><a href="#gallery">Галлерей</a></li>
        <li><a href="#gallery" class="nav-cta">Загварууд</a></li>
      </ul>
      <button class="hamburger" id="hamburger" onclick="toggleMenu()">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <a href="#home" onclick="closeMenu()">Нүүр</a>
      <a href="#products" onclick="closeMenu()">Бүтээгдэхүүн</a>
      <a href="#about" onclick="closeMenu()">Танилцуулга</a>
      <a href="#gallery" onclick="closeMenu()">Галлерей</a>
      <a href="#gallery" onclick="closeMenu()">Загварууд</a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero" id="home">
    <div class="hero-bg">
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow">      Толь, шилэн хийцийн загварын танилцуулга</p>
      <h1 class="hero-title">
        Гоо сайхан <br/>
        <em>шилэн</em> дизайн
      </h1>
      <p class="hero-desc">
        Декоратив толь, өнгөт болон хээтэй шилний төрлүүдийг зураг, тайлбартай
        үзэж, өөрийн орон зайдаа тохирох загварын санаа аваарай.
      </p>
      <div class="hero-actions">
        <a href="#gallery" class="btn-gold">Загварууд үзэх</a>
        <a href="#about" class="btn-outline">Танилцуулга унших</a>
      </div>
    </div>
    <div class="hero-scroll">
      <div class="scroll-line"></div>
      <span>Доош гүйлгэ</span>
    </div>
    <!-- Floating product preview -->
    <div class="hero-preview">
      <div class="preview-card">
        <img src="images/mirror-gold.jpg" alt="Алтан хүрээт шил" />
      </div>
    </div>
  </section>

  <!-- Showcase categories -->
  <section class="stats-bar">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-num">Толь</span>
        <span class="stat-lbl">Хүрээтэй болон интерьерийн загвар</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-num">Өнгөт</span>
        <span class="stat-lbl">Хар, цэнхэр, хүрэл өнгийн шил</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-num">Хээтэй</span>
        <span class="stat-lbl">Судалтай шилэн гадаргуу</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-num">Интерьер</span>
        <span class="stat-lbl">Өрөөнд байрлуулах санаанууд</span>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="products" id="products">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Шилэн хийцийн төрлүүд</span>
        <h2>Толь ба шилний <em>загварууд</em></h2>
        <p>Өнгө, хүрээ болон гадаргууны ялгааг харьцуулж үзээрэй</p>
      </div>

      <div class="products-grid">

        <!-- Product 1: Gold Mirror -->
        <div class="product-card" id="prod-gold">
          <div class="product-img-wrap">
            <img src="images/mirror-gold.jpg" alt="Алтан хүрээт толь" class="product-img" />
            <div class="product-overlay">
              <button class="overlay-btn" onclick="openModal('modal-gold')">Дэлгэрэнгүй</button>
            </div>
          </div>
          <div class="product-info">
            <span class="product-cat">Декоратив толь</span>
            <h3>Алтан хүрээт толь</h3>
            <p>Алтан шаргал хүрээ, дулаан хүрэн туяатай толин гадаргууг хослуулсан загвар. Зочны өрөө, унтлагын өрөөний дулаан өнгийн интерьерт зохицно.</p>
            <div class="product-details">
              <span>Өнгө: Алтан шаргал хүрээ, хүрэн туяатай толь</span>
              <span>Хэв маяг: Дулаан, сонгодог</span>
            </div>
          </div>
        </div>

        <!-- Product 2: Black Mirror -->
        <div class="product-card" id="prod-black">
          <div class="product-img-wrap">
            <img src="images/mirror-black.jpg" alt="Хар хүрээт толь" class="product-img" />
            <div class="product-overlay">
              <button class="overlay-btn" onclick="openModal('modal-black')">Дэлгэрэнгүй</button>
            </div>
          </div>
          <div class="product-info">
            <span class="product-cat">Декоратив толь</span>
            <h3>Хар хүрээт толь</h3>
            <p>Нарийн хар хүрээ болон саарал толин гадаргуу нь цэвэрхэн, минимал төрх бүрдүүлнэ. Цайвар ханатай орон зайд тод ялгарна.</p>
            <div class="product-details">
              <span>Өнгө: Хар хүрээ, саарал шил</span>
              <span>Хэв маяг: Минимал, орчин үеийн</span>
            </div>
          </div>
        </div>

        <!-- Product 3: Champagne Mirror -->
        <div class="product-card" id="prod-champ">
          <div class="product-img-wrap">
            <img src="images/mirror-champagne.jpg" alt="Шампань хүрээт толь" class="product-img" />
            <div class="product-overlay">
              <button class="overlay-btn" onclick="openModal('modal-champ')">Дэлгэрэнгүй</button>
            </div>
          </div>
          <div class="product-info">
            <span class="product-cat">Декоратив толь</span>
            <h3>Шампань хүрээт толь</h3>
            <p>Цайвар шампань хүрээ нь толины загварт зөөлөн, дулаан өнгө нэмнэ. Модон болон саармаг өнгийн тавилгатай хослуулахад зохимжтой.</p>
            <div class="product-details">
              <span>Өнгө: Шампань буюу цайвар алтлаг</span>
              <span>Хэв маяг: Зөөлөн, дулаан</span>
            </div>
          </div>
        </div>

        <!-- Product 4: Textured Glass -->
        <div class="product-card featured-card" id="prod-texture">
          <div class="product-img-wrap">
            <img src="images/glass-ribbed-cream.jpg" alt="Цайвар судалтай шил" class="product-img" />
            <div class="product-overlay">
              <button class="overlay-btn" onclick="openModal('modal-texture')">Дэлгэрэнгүй</button>
            </div>
          </div>
          <div class="product-info">
            <span class="product-cat">Архитектурын шил</span>
            <h3>Судалтай архитектурын шил</h3>
            <p>Нарийн хөндлөн судал нь гадаргууд хэмнэл, бүтэц оруулна. Хаалга, таславч болон тавилгын шилэн хэсэгт ашиглаж болох загварын санаа.</p>
            <div class="product-details">
              <span>Өнгө: Цайвар, бараан сонголт</span>
              <span>Хээ: Хөндлөн судал</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="about">
    <div class="about-bg"></div>
    <div class="container about-inner">
      <div class="about-img-col">
        <div class="about-img-stack">
          <img src="images/mirror-organic-installed.jpg" alt="Гэрэлтүүлэгтэй органик хэлбэрийн толь" class="about-img-main" loading="lazy" decoding="async" />
          <img src="images/mirror-arch-installed.jpg" alt="Хар хүрээтэй нуман толь" class="about-img-second" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="about-text-col">
        <span class="eyebrow">Танилцуулга</span>
        <h2>Шилэн хийцийн <em>загварын санаа</em></h2>
        <p class="about-lead">
          Энэ хуудас нь толь, өнгөт шил болон судалтай шилэн хийцийн төрлүүдийг танилцуулах үзүүлэн юм.
        </p>
        <p>
          Зураг бүрийн доорх тайлбараас өнгө, хэлбэр, гадаргуугийн ялгааг харьцуулж үзээрэй. Зургууд нь санаа авах жишээ бөгөөд бодит өнгө нь дэлгэц, гэрэлтүүлгээс шалтгаалан өөр харагдаж болно.
        </p>
        <div class="about-points">
          <div class="apoint">
            <div class="apoint-icon">◆</div>
            <div>
              <strong>Толины загварууд</strong>
              <p>Алтан, хар, шампань хүрээтэй болон интерьерийн жишээ</p>
            </div>
          </div>
          <div class="apoint">
            <div class="apoint-icon">◆</div>
            <div>
              <strong>Өнгөт шил</strong>
              <p>Хар, цэнхэр, хүрэл болон цайвар өнгөний жишээ</p>
            </div>
          </div>
          <div class="apoint">
            <div class="apoint-icon">◆</div>
            <div>
              <strong>Хээтэй гадаргуу</strong>
              <p>Цайвар, бараан судалтай шилэн хийцийн санаанууд</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="gallery" id="gallery">
    <div class="container">
      <div class="section-head light">
